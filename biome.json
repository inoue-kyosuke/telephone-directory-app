{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!worker-configuration.d.ts", "!Logs"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "overrides": [
    {
      "includes": ["**/*.jsonc"],
      "json": { "parser": { "allowTrailingCommas": true }, "formatter": { "trailingCommas": "all" } }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
